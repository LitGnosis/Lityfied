{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/fulfillment-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/catalog-alerts",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/lifecycle",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/cron/email-outbox",
      "schedule": "*/10 * * * *"
    }
  ],
  "installCommand": "npm ci",
  "buildCommand": "node scripts/prepare-build.mjs && npm run build"
}
