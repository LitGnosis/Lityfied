# Public canonical site URL
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Stripe server credentials: set in Vercel, never expose to the browser
LG_STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Database provider connection string (Neon Marketplace recommended)
DATABASE_URL=
# Auth provider server secret and public key
AUTH_SECRET=
NEXT_PUBLIC_AUTH_PUBLISHABLE_KEY=
# Transactional email provider
EMAIL_API_KEY=
# Fulfillment/shipping provider
SHIPPING_API_KEY=
# Vercel Blob token for product media uploads
BLOB_READ_WRITE_TOKEN=
