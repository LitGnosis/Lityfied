# Core supplier catalog + fulfillment
CJ_API_KEY=
CJ_DEFAULT_LOGISTICS=
CJ_DEFAULT_FROM_COUNTRY=CN
# Keep false until test-mode supplier fulfillment is verified.
CJ_AUTO_PAY_BALANCE=false

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
STRIPE_ALLOW_PROMOTION_CODES=false

# Store pricing / public identity
RETAIL_MARKUP_MULTIPLIER=2.2
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Persistent commerce database
DATABASE_URL=

# Operations/security
FULFILLMENT_RECOVERY_SECRET=
CRON_SECRET=
# Owner secret. ADMIN_SECRET remains supported as a legacy fallback.
ADMIN_OWNER_SECRET=
ADMIN_SECRET=
# Optional scoped staff secrets.
ADMIN_OPERATIONS_SECRET=
ADMIN_SUPPORT_SECRET=
ADMIN_MARKETING_SECRET=

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=

# Optional observability destination; never expose this client-side.
OBSERVABILITY_WEBHOOK_URL=

# Optional review photo/video storage. New Vercel Blob projects can use OIDC automatically; this token is useful for local/manual setups.
BLOB_READ_WRITE_TOKEN=

# Default closed. Set only after the signed payment lifecycle, provider tests,
# failures, backups and operational checks in LAUNCH_STATUS.md are verified.
LIVE_COMMERCE_ENABLED=false
LAUNCH_VERIFIED_RELEASE=
CJ_FULFILLMENT_ENABLED=false
